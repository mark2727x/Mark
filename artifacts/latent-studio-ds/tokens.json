{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Latent Studio Design System — extracted from the Dark AI Render Music Player mockup. Burnt-orange primary on near-black warm surfaces. Space Grotesk / Instrument Serif / JetBrains Mono. Sharp corners, high contrast, grid-ruled aesthetic.",
  "color": {
    "$type": "color",
    "light": {
      "background":              { "$value": "#f5f0e8", "$description": "Warm parchment page background" },
      "foreground":              { "$value": "#0d0b08" },
      "border":                  { "$value": "#d5cec4" },
      "card":                    { "$value": "#ece5d8", "$description": "Warm cream card surface" },
      "cardForeground":          { "$value": "#0d0b08" },
      "popover":                 { "$value": "#f5f0e8" },
      "popoverForeground":       { "$value": "#0d0b08" },
      "primary":                 { "$value": "#ff4d00", "$description": "Burnt orange — primary action, links, focus" },
      "primaryForeground":       { "$value": "#ffffff" },
      "secondary":               { "$value": "#e8e2d8" },
      "secondaryForeground":     { "$value": "#1a1410" },
      "muted":                   { "$value": "#e8e2d8" },
      "mutedForeground":         { "$value": "#7a6f5c", "$description": "Warm gray-brown for subdued labels" },
      "accent":                  { "$value": "#ffe8d8", "$description": "Warm orange tint for hover/selected state" },
      "accentForeground":        { "$value": "#1a1410" },
      "destructive":             { "$value": "#dc2626" },
      "destructiveForeground":   { "$value": "#ffffff" },
      "input":                   { "$value": "#d5cec4" },
      "ring":                    { "$value": "#ff4d00" },
      "chart1":                  { "$value": "#ff4d00" },
      "chart2":                  { "$value": "#4a9e3e" },
      "chart3":                  { "$value": "#7a6f5c" },
      "chart4":                  { "$value": "#b9ae98" },
      "chart5":                  { "$value": "#e8b06a" },
      "sidebar":                 { "$value": "#ece5d8" },
      "sidebarForeground":       { "$value": "#0d0b08" },
      "sidebarBorder":           { "$value": "#d5cec4" },
      "sidebarPrimary":          { "$value": "#ff4d00" },
      "sidebarPrimaryForeground":{ "$value": "#ffffff" },
      "sidebarAccent":           { "$value": "#e0d9cf" },
      "sidebarAccentForeground": { "$value": "#0d0b08" },
      "sidebarRing":             { "$value": "#ff4d00" }
    },
    "dark": {
      "background":              { "$value": "#0d0b08", "$description": "Near-black warm dark — the signature surface" },
      "foreground":              { "$value": "#ece5d8", "$description": "Warm cream/parchment text" },
      "border":                  { "$value": "#221d15" },
      "card":                    { "$value": "#17130d", "$description": "Elevated warm dark for cards/panels" },
      "cardForeground":          { "$value": "#ece5d8" },
      "popover":                 { "$value": "#17130d" },
      "popoverForeground":       { "$value": "#ece5d8" },
      "primary":                 { "$value": "#ff4d00", "$description": "Burnt orange — identical in both modes" },
      "primaryForeground":       { "$value": "#0d0b08" },
      "secondary":               { "$value": "#221d15" },
      "secondaryForeground":     { "$value": "#cdc4b2" },
      "muted":                   { "$value": "#2c261c" },
      "mutedForeground":         { "$value": "#7a6f5c" },
      "accent":                  { "$value": "#2c261c" },
      "accentForeground":        { "$value": "#ece5d8" },
      "destructive":             { "$value": "#ef4444" },
      "destructiveForeground":   { "$value": "#0d0b08" },
      "input":                   { "$value": "#2c261c" },
      "ring":                    { "$value": "#ff4d00" },
      "chart1":                  { "$value": "#ff4d00" },
      "chart2":                  { "$value": "#7fd068", "$description": "Live/active green from the studio status indicator" },
      "chart3":                  { "$value": "#cdc4b2" },
      "chart4":                  { "$value": "#b9ae98" },
      "chart5":                  { "$value": "#564d3d" },
      "sidebar":                 { "$value": "#13100b" },
      "sidebarForeground":       { "$value": "#cdc4b2" },
      "sidebarBorder":           { "$value": "#221d15" },
      "sidebarPrimary":          { "$value": "#ff4d00" },
      "sidebarPrimaryForeground":{ "$value": "#0d0b08" },
      "sidebarAccent":           { "$value": "#1c1812" },
      "sidebarAccentForeground": { "$value": "#ece5d8" },
      "sidebarRing":             { "$value": "#ff4d00" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Space Grotesk", "sans-serif"],    "$description": "Primary UI typeface — geometric, technical, clean" },
      "serif": { "$value": ["Instrument Serif", "serif"],      "$description": "Display / editorial serif for titles and headings" },
      "mono":  { "$value": ["JetBrains Mono", "monospace"],    "$description": "Code, seeds, model IDs, technical metadata" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.125rem",
      "$description": "Very sharp corners — the system favours straight edges over rounded ones. 2px is the maximum softening."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step."
    }
  }
}
